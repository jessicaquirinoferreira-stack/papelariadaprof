{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator identity document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Student account profile with contact details (PII isolated to owner and admin).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 140 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 30 },
        "cep": { "type": "string", "maxLength": 12 },
        "address": { "type": "string", "maxLength": 240 },
        "city": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 10 },
        "role": { "type": "string", "enum": ["student"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "role", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Physical stationery or pedagogical product in the storefront catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 2500 },
        "category": { "type": "string", "minLength": 2, "maxLength": 80 },
        "price": { "type": "number" },
        "compareAtPrice": { "type": "number" },
        "stock": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "badge": { "type": "string", "maxLength": 40 },
        "featured": { "type": "boolean" },
        "active": { "type": "boolean" },
        "salesCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "description", "category", "price", "stock", "imageUrl", "featured", "active", "salesCount", "createdAt", "updatedAt"]
    },
    "Material": {
      "title": "Material",
      "description": "Exclusive digital workbook / PDF metadata visible in the catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 2500 },
        "category": { "type": "string", "minLength": 2, "maxLength": 80 },
        "price": { "type": "number" },
        "coverUrl": { "type": "string", "maxLength": 1000 },
        "pagesCount": { "type": "number" },
        "stock": { "type": "number" },
        "featured": { "type": "boolean" },
        "active": { "type": "boolean" },
        "salesCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "description", "category", "price", "coverUrl", "pagesCount", "stock", "featured", "active", "salesCount", "createdAt", "updatedAt"]
    },
    "MaterialFile": {
      "title": "MaterialFile",
      "description": "Private PDF storage URL for an exclusive digital material (admin-only and granted-student access).",
      "type": "object",
      "properties": {
        "materialId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "pdfUrl": { "type": "string", "maxLength": 1500 },
        "pdfFileName": { "type": "string", "maxLength": 200 },
        "fileSizeBytes": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["materialId", "pdfUrl", "pdfFileName", "updatedAt"]
    },
    "StudentMaterial": {
      "title": "StudentMaterial",
      "description": "Unlocked digital material grant connecting a student to a downloadable PDF.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "maxLength": 140 },
        "studentEmail": { "type": "string", "maxLength": 200 },
        "materialId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "materialTitle": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "maxLength": 80 },
        "coverUrl": { "type": "string", "maxLength": 1000 },
        "pdfUrl": { "type": "string", "maxLength": 1500 },
        "pdfFileName": { "type": "string", "maxLength": 200 },
        "orderRef": { "type": "string", "maxLength": 80 },
        "unlockedBy": { "type": "string", "maxLength": 128 },
        "unlockedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "studentId", "studentName", "studentEmail", "materialId", "materialTitle", "category", "coverUrl", "pdfUrl", "pdfFileName", "unlockedBy", "unlockedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer or PDV order with shipping, coupon, and item summary.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderNumber": { "type": "string", "maxLength": 40 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 140 },
        "customerPhone": { "type": "string", "minLength": 8, "maxLength": 30 },
        "customerEmail": { "type": "string", "maxLength": 200 },
        "cep": { "type": "string", "maxLength": 12 },
        "address": { "type": "string", "maxLength": 300 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shippingCost": { "type": "number" },
        "discount": { "type": "number" },
        "couponCode": { "type": "string", "maxLength": 40 },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "source": { "type": "string", "enum": ["online", "pdv"] },
        "status": { "type": "string", "enum": ["pending", "paid", "shipped", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orderNumber", "customerName", "customerPhone", "items", "subtotal", "shippingCost", "discount", "total", "source", "status", "createdAt", "updatedAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon configured by admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 2, "maxLength": 40 },
        "type": { "type": "string", "enum": ["percent", "fixed"] },
        "value": { "type": "number" },
        "minOrder": { "type": "number" },
        "active": { "type": "boolean" },
        "usageCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "type", "value", "minOrder", "active", "usageCount", "createdAt"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Public store configuration including WhatsApp, Instagram, hours, hero copy, categories, and Quem sou eu biography.",
      "type": "object",
      "properties": {
        "storeName": { "type": "string", "maxLength": 100 },
        "whatsappNumber": { "type": "string", "maxLength": 24 },
        "instagramUrl": { "type": "string", "maxLength": 300 },
        "instagramHandle": { "type": "string", "maxLength": 60 },
        "contactEmail": { "type": "string", "maxLength": 160 },
        "businessHours": { "type": "string", "maxLength": 160 },
        "heroTitle": { "type": "string", "maxLength": 140 },
        "heroSubtitle": { "type": "string", "maxLength": 360 },
        "freeShippingThreshold": { "type": "number" },
        "assistantName": { "type": "string", "maxLength": 60 },
        "categories": { "type": "array" },
        "deletedMaterialIds": { "type": "array" },
        "aboutTitle": { "type": "string", "maxLength": 160 },
        "aboutSubtitle": { "type": "string", "maxLength": 300 },
        "aboutPhotoUrl": { "type": "string", "maxLength": 1000 },
        "aboutText": { "type": "string", "maxLength": 5000 },
        "aboutCredentials": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["storeName", "whatsappNumber", "instagramUrl", "contactEmail", "businessHours", "heroTitle", "heroSubtitle", "freeShippingThreshold", "assistantName", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin authorization documents keyed by UID."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/StudentProfile" },
      "description": "Student profiles with isolated PII."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Physical storefront products."
    },
    "/materials/{materialId}": {
      "schema": { "$ref": "#/entities/Material" },
      "description": "Public metadata for exclusive digital PDFs and workbooks."
    },
    "/materials/{materialId}/private/{docId}": {
      "schema": { "$ref": "#/entities/MaterialFile" },
      "description": "Private PDF download URLs separated from public catalog listings."
    },
    "/student_materials/{grantId}": {
      "schema": { "$ref": "#/entities/StudentMaterial" },
      "description": "Materials unlocked by admin for specific students."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer storefront orders and in-store PDV sales."
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Store discount coupons."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "General store settings and social links."
    }
  }
}
