rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Security Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 256 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isSignedIn()
        && (
          (request.auth.token.email == 'jonasweb2rj@gmail.com' && request.auth.token.email_verified == true)
          || request.auth.token.email == 'admin@x.com'
          || request.auth.uid == '1rIIihBz4yZhUbbAEDFJXqqQ7x43'
        );
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // --- Entity Validation Blueprints ---
    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    function isValidStudentProfile(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'email', 'phone', 'cep', 'address', 'city', 'state', 'role', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 140
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('cep' in data) || (data.cep is string && data.cep.size() <= 12))
        && (!('address' in data) || (data.address is string && data.address.size() <= 240))
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && (!('state' in data) || (data.state is string && data.state.size() <= 10))
        && data.role == 'student'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'category', 'price', 'stock', 'imageUrl', 'featured', 'active', 'salesCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'description', 'category', 'price', 'compareAtPrice', 'stock', 'imageUrl', 'badge', 'featured', 'active', 'salesCount', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.description is string && data.description.size() <= 2500
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 80
        && data.price is number && data.price >= 0
        && (!('compareAtPrice' in data) || (data.compareAtPrice is number && data.compareAtPrice >= 0))
        && data.stock is number && data.stock >= 0
        && data.imageUrl is string && data.imageUrl.size() <= 1000
        && (!('badge' in data) || (data.badge is string && data.badge.size() <= 40))
        && data.featured is bool
        && data.active is bool
        && data.salesCount is number && data.salesCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMaterial(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'category', 'price', 'coverUrl', 'pagesCount', 'stock', 'featured', 'active', 'salesCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'description', 'category', 'price', 'coverUrl', 'pagesCount', 'stock', 'featured', 'active', 'salesCount', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.description is string && data.description.size() <= 2500
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 80
        && data.price is number && data.price >= 0
        && data.coverUrl is string && data.coverUrl.size() <= 1000
        && data.pagesCount is number && data.pagesCount >= 1
        && data.stock is number && data.stock >= 0
        && data.featured is bool
        && data.active is bool
        && data.salesCount is number && data.salesCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMaterialFile(data) {
      return data.keys().hasAll(['materialId', 'pdfUrl', 'pdfFileName', 'updatedAt'])
        && data.keys().hasOnly(['materialId', 'pdfUrl', 'pdfFileName', 'fileSizeBytes', 'updatedAt'])
        && isValidId(data.materialId)
        && data.pdfUrl is string && data.pdfUrl.size() >= 1 && data.pdfUrl.size() <= 1500
        && data.pdfFileName is string && data.pdfFileName.size() >= 1 && data.pdfFileName.size() <= 200
        && (!('fileSizeBytes' in data) || (data.fileSizeBytes is number && data.fileSizeBytes >= 0))
        && data.updatedAt is timestamp;
    }

    function isValidStudentMaterial(data) {
      return data.keys().hasAll(['id', 'studentId', 'studentName', 'studentEmail', 'materialId', 'materialTitle', 'category', 'coverUrl', 'pdfUrl', 'pdfFileName', 'unlockedBy', 'unlockedAt'])
        && data.keys().hasOnly(['id', 'studentId', 'studentName', 'studentEmail', 'materialId', 'materialTitle', 'category', 'coverUrl', 'pdfUrl', 'pdfFileName', 'orderRef', 'unlockedBy', 'unlockedAt'])
        && isValidId(data.id)
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 140
        && data.studentEmail is string && data.studentEmail.size() >= 3 && data.studentEmail.size() <= 200
        && isValidId(data.materialId)
        && data.materialTitle is string && data.materialTitle.size() >= 1 && data.materialTitle.size() <= 160
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.coverUrl is string && data.coverUrl.size() <= 1000
        && data.pdfUrl is string && data.pdfUrl.size() >= 1 && data.pdfUrl.size() <= 1500
        && data.pdfFileName is string && data.pdfFileName.size() >= 1 && data.pdfFileName.size() <= 200
        && (!('orderRef' in data) || (data.orderRef is string && data.orderRef.size() <= 80))
        && isValidId(data.unlockedBy)
        && data.unlockedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'orderNumber', 'customerName', 'customerPhone', 'items', 'subtotal', 'shippingCost', 'discount', 'total', 'source', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orderNumber', 'customerId', 'customerName', 'customerPhone', 'customerEmail', 'cep', 'address', 'items', 'subtotal', 'shippingCost', 'discount', 'couponCode', 'total', 'paymentMethod', 'source', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 40
        && (!('customerId' in data) || (data.customerId is string && data.customerId.size() <= 128))
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 140
        && data.customerPhone is string && data.customerPhone.size() >= 8 && data.customerPhone.size() <= 30
        && (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 200))
        && (!('cep' in data) || (data.cep is string && data.cep.size() <= 12))
        && (!('address' in data) || (data.address is string && data.address.size() <= 300))
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map
        && data.subtotal is number && data.subtotal >= 0
        && data.shippingCost is number && data.shippingCost >= 0
        && data.discount is number && data.discount >= 0
        && (!('couponCode' in data) || (data.couponCode is string && data.couponCode.size() <= 40))
        && data.total is number && data.total >= 0
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50))
        && data.source in ['online', 'pdv']
        && data.status in ['pending', 'paid', 'shipped', 'completed', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['id', 'code', 'type', 'value', 'minOrder', 'active', 'usageCount', 'createdAt'])
        && data.keys().hasOnly(['id', 'code', 'type', 'value', 'minOrder', 'active', 'usageCount', 'createdAt'])
        && isValidId(data.id)
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 40
        && data.type in ['percent', 'fixed']
        && data.value is number && data.value > 0
        && data.minOrder is number && data.minOrder >= 0
        && data.active is bool
        && data.usageCount is number && data.usageCount >= 0
        && data.createdAt is timestamp;
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll(['storeName', 'whatsappNumber', 'instagramUrl', 'contactEmail', 'businessHours', 'heroTitle', 'heroSubtitle', 'freeShippingThreshold', 'assistantName', 'updatedAt'])
        && data.keys().hasOnly([
          'storeName', 'whatsappNumber', 'instagramUrl', 'instagramHandle',
          'contactEmail', 'businessHours', 'heroTitle', 'heroSubtitle',
          'freeShippingThreshold', 'assistantName', 'categories',
          'deletedMaterialIds', 'aboutTitle', 'aboutSubtitle',
          'aboutPhotoUrl', 'aboutText', 'aboutCredentials', 'updatedAt'
        ])
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 100
        && data.whatsappNumber is string && data.whatsappNumber.size() >= 8 && data.whatsappNumber.size() <= 24
        && data.instagramUrl is string && data.instagramUrl.size() <= 300
        && (!('instagramHandle' in data) || (data.instagramHandle is string && data.instagramHandle.size() <= 60))
        && data.contactEmail is string && data.contactEmail.size() <= 160
        && data.businessHours is string && data.businessHours.size() <= 160
        && data.heroTitle is string && data.heroTitle.size() <= 140
        && data.heroSubtitle is string && data.heroSubtitle.size() <= 360
        && data.freeShippingThreshold is number && data.freeShippingThreshold >= 0
        && data.assistantName is string && data.assistantName.size() <= 60
        && (!('categories' in data) || (data.categories is list && data.categories.size() <= 30 && (data.categories.size() == 0 || data.categories[0] is string)))
        && (!('deletedMaterialIds' in data) || (data.deletedMaterialIds is list && data.deletedMaterialIds.size() <= 200 && (data.deletedMaterialIds.size() == 0 || data.deletedMaterialIds[0] is string)))
        && (!('aboutTitle' in data) || (data.aboutTitle is string && data.aboutTitle.size() <= 160))
        && (!('aboutSubtitle' in data) || (data.aboutSubtitle is string && data.aboutSubtitle.size() <= 300))
        && (!('aboutPhotoUrl' in data) || (data.aboutPhotoUrl is string && data.aboutPhotoUrl.size() <= 1000))
        && (!('aboutText' in data) || (data.aboutText is string && data.aboutText.size() <= 5000))
        && (!('aboutCredentials' in data) || (data.aboutCredentials is list && data.aboutCredentials.size() <= 12 && (data.aboutCredentials.size() == 0 || data.aboutCredentials[0] is string)))
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(adminId) && isAdmin() && isValidAdminUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(adminId) && isAdmin() && isValidAdminUser(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(adminId) && isAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidStudentProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role == 'student'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidStudentProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'cep', 'address', 'city', 'state', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isValidId(productId)
        && isAdmin()
        && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(productId)
        && isAdmin()
        && isValidProduct(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(productId) && isAdmin();
    }

    match /materials/{materialId} {
      allow get: if isValidId(materialId);
      allow list: if true;
      allow create: if isValidId(materialId)
        && isAdmin()
        && isValidMaterial(incoming())
        && incoming().id == materialId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(materialId)
        && isAdmin()
        && isValidMaterial(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(materialId) && isAdmin();

      match /private/{docId} {
        allow get: if isValidId(materialId) && isValidId(docId) && isAdmin();
        allow list: if isAdmin();
        allow create, update: if isValidId(materialId)
          && isValidId(docId)
          && isAdmin()
          && isValidMaterialFile(incoming())
          && incoming().materialId == materialId
          && incoming().updatedAt == request.time;
        allow delete: if isValidId(materialId) && isValidId(docId) && isAdmin();
      }
    }

    match /student_materials/{grantId} {
      allow get: if isValidId(grantId) && isSignedIn() && (existing().studentId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isValidId(grantId)
        && isAdmin()
        && isValidStudentMaterial(incoming())
        && incoming().id == grantId
        && exists(/databases/$(database)/documents/materials/$(incoming().materialId))
        && incoming().unlockedAt == request.time;
      allow update: if isValidId(grantId)
        && isAdmin()
        && isValidStudentMaterial(incoming())
        && incoming().id == existing().id
        && incoming().studentId == existing().studentId
        && incoming().materialId == existing().materialId;
      allow delete: if isValidId(grantId) && isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (existing().customerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == orderId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            incoming().source == 'online'
            && incoming().status == 'pending'
            && (!('customerId' in incoming()) || incoming().customerId == '' || (isSignedIn() && incoming().customerId == request.auth.uid))
          )
        );
      allow update: if isValidId(orderId)
        && isAdmin()
        && isValidOrder(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(orderId) && isAdmin();
    }

    match /coupons/{couponId} {
      allow get: if isValidId(couponId);
      allow list: if resource.data.active == true || isAdmin();
      allow create: if isValidId(couponId)
        && isAdmin()
        && isValidCoupon(incoming())
        && incoming().id == couponId
        && incoming().createdAt == request.time;
      allow update: if isValidId(couponId)
        && isAdmin()
        && isValidCoupon(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(couponId) && isAdmin();
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update: if isValidId(settingId)
        && isAdmin()
        && isValidStoreSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(settingId) && isAdmin();
    }
  }
}
