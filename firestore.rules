rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && request.auth.token.email in ['jonasjessicalove@gmail.com', 'admin@x.com']) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
        'id', 'slug', 'name', 'shortDescription', 'description', 'price',
        'stock', 'category', 'resourceType', 'recommendedAge', 'tags',
        'images', 'featured', 'active', 'salesCount', 'weightGrams',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'slug', 'name', 'shortDescription', 'description', 'price',
        'promoPrice', 'stock', 'category', 'resourceType', 'recommendedAge',
        'tags', 'images', 'videoUrl', 'variants', 'featured', 'active',
        'salesCount', 'weightGrams', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 140 && data.slug.matches('^[a-z0-9\\-]+$')
      && data.name is string && data.name.size() >= 2 && data.name.size() <= 160
      && data.shortDescription is string && data.shortDescription.size() >= 2 && data.shortDescription.size() <= 300
      && data.description is string && data.description.size() >= 2 && data.description.size() <= 8000
      && data.price is number && data.price >= 0 && data.price <= 100000
      && (!('promoPrice' in data) || data.promoPrice == null || (data.promoPrice is number && data.promoPrice >= 0 && data.promoPrice <= 100000))
      && data.stock is number && data.stock >= 0 && data.stock <= 100000
      && data.category is string && data.category.size() >= 2 && data.category.size() <= 80
      && data.resourceType in ['pedagogico', 'terapeutico', 'ambos', 'papelaria']
      && data.recommendedAge is string && data.recommendedAge.size() >= 2 && data.recommendedAge.size() <= 60
      && data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string)
      && data.images is list && data.images.size() >= 1 && data.images.size() <= 8 && data.images[0] is string
      && (!('videoUrl' in data) || data.videoUrl == null || (data.videoUrl is string && data.videoUrl.size() <= 500))
      && (!('variants' in data) || data.variants == null || (data.variants is list && data.variants.size() <= 10 && (data.variants.size() == 0 || data.variants[0] is map)))
      && data.featured is bool
      && data.active is bool
      && data.salesCount is number && data.salesCount >= 0
      && data.weightGrams is number && data.weightGrams >= 1 && data.weightGrams <= 50000;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
        'id', 'orderNumber', 'customerName', 'customerPhone', 'items',
        'subtotal', 'shippingMethod', 'shippingCost', 'discount', 'total',
        'status', 'source', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'orderNumber', 'customerName', 'customerPhone', 'customerEmail',
        'cep', 'street', 'number', 'complement', 'neighborhood', 'city', 'state',
        'items', 'subtotal', 'shippingMethod', 'shippingCost', 'couponCode',
        'discount', 'total', 'status', 'source', 'notes', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 32
      && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 140
      && data.customerPhone is string && data.customerPhone.size() >= 8 && data.customerPhone.size() <= 30
      && (!('customerEmail' in data) || data.customerEmail == null || (data.customerEmail is string && data.customerEmail.size() <= 160))
      && (!('cep' in data) || data.cep == null || (data.cep is string && data.cep.size() <= 12))
      && (!('street' in data) || data.street == null || (data.street is string && data.street.size() <= 200))
      && (!('number' in data) || data.number == null || (data.number is string && data.number.size() <= 24))
      && (!('complement' in data) || data.complement == null || (data.complement is string && data.complement.size() <= 120))
      && (!('neighborhood' in data) || data.neighborhood == null || (data.neighborhood is string && data.neighborhood.size() <= 120))
      && (!('city' in data) || data.city == null || (data.city is string && data.city.size() <= 120))
      && (!('state' in data) || data.state == null || (data.state is string && data.state.size() <= 4))
      && data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map
      && data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 500000
      && data.shippingMethod is string && data.shippingMethod.size() >= 2 && data.shippingMethod.size() <= 60
      && data.shippingCost is number && data.shippingCost >= 0 && data.shippingCost <= 10000
      && (!('couponCode' in data) || data.couponCode == null || (data.couponCode is string && data.couponCode.size() <= 40))
      && data.discount is number && data.discount >= 0 && data.discount <= 500000
      && data.total is number && data.total >= 0 && data.total <= 500000
      && data.status in ['pendente', 'em_andamento', 'finalizado', 'cancelado']
      && data.source in ['loja', 'pdv']
      && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 600));
    }

    function isValidCoupon(data) {
      return data.keys().hasAll([
        'code', 'type', 'value', 'minOrderValue', 'maxUses',
        'usedCount', 'expiresAt', 'active', 'createdAt'
      ])
      && data.keys().hasOnly([
        'code', 'type', 'value', 'minOrderValue', 'maxUses',
        'usedCount', 'expiresAt', 'active', 'createdAt'
      ])
      && data.code is string && data.code.size() >= 2 && data.code.size() <= 40 && data.code.matches('^[A-Z0-9_\\-]+$')
      && data.type in ['percent', 'fixed']
      && data.value is number && data.value > 0 && data.value <= 100000
      && data.minOrderValue is number && data.minOrderValue >= 0 && data.minOrderValue <= 100000
      && data.maxUses is number && data.maxUses >= 1 && data.maxUses <= 1000000
      && data.usedCount is number && data.usedCount >= 0 && data.usedCount <= 1000000
      && data.expiresAt is string && data.expiresAt.size() <= 40
      && data.active is bool;
    }

    function isValidSettings(data) {
      return data.keys().hasAll([
        'storeName', 'tagline', 'primaryColor', 'accentColor', 'whatsappNumber',
        'instagramUrl', 'contactEmail', 'cityState', 'originCep',
        'freeShippingThreshold', 'welcomeMessage', 'footerText',
        'shippingPolicy', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'storeName', 'tagline', 'primaryColor', 'accentColor', 'whatsappNumber',
        'instagramUrl', 'facebookUrl', 'tiktokUrl', 'contactEmail', 'cityState',
        'originCep', 'freeShippingThreshold', 'welcomeMessage', 'footerText',
        'shippingPolicy', 'updatedAt'
      ])
      && data.storeName is string && data.storeName.size() >= 2 && data.storeName.size() <= 100
      && data.tagline is string && data.tagline.size() <= 140
      && data.primaryColor is string && data.primaryColor.size() <= 24
      && data.accentColor is string && data.accentColor.size() <= 24
      && data.whatsappNumber is string && data.whatsappNumber.size() >= 10 && data.whatsappNumber.size() <= 20
      && data.instagramUrl is string && data.instagramUrl.size() <= 300
      && (!('facebookUrl' in data) || data.facebookUrl == null || (data.facebookUrl is string && data.facebookUrl.size() <= 300))
      && (!('tiktokUrl' in data) || data.tiktokUrl == null || (data.tiktokUrl is string && data.tiktokUrl.size() <= 300))
      && data.contactEmail is string && data.contactEmail.size() <= 160
      && data.cityState is string && data.cityState.size() <= 120
      && data.originCep is string && data.originCep.size() <= 12
      && data.freeShippingThreshold is number && data.freeShippingThreshold >= 0 && data.freeShippingThreshold <= 100000
      && data.welcomeMessage is string && data.welcomeMessage.size() <= 1000
      && data.footerText is string && data.footerText.size() <= 500
      && data.shippingPolicy is string && data.shippingPolicy.size() <= 2000;
    }

    function isValidBlogPost(data) {
      return data.keys().hasAll([
        'id', 'slug', 'title', 'excerpt', 'content', 'category',
        'readTime', 'coverImage', 'published', 'publishedAt'
      ])
      && data.keys().hasOnly([
        'id', 'slug', 'title', 'excerpt', 'content', 'category',
        'readTime', 'coverImage', 'published', 'publishedAt'
      ])
      && isValidId(data.id)
      && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 140 && data.slug.matches('^[a-z0-9\\-]+$')
      && data.title is string && data.title.size() >= 3 && data.title.size() <= 180
      && data.excerpt is string && data.excerpt.size() >= 10 && data.excerpt.size() <= 400
      && data.content is string && data.content.size() >= 20 && data.content.size() <= 12000
      && data.category is string && data.category.size() <= 80
      && data.readTime is string && data.readTime.size() <= 30
      && data.coverImage is string && data.coverImage.size() <= 500
      && data.published is bool
      && data.publishedAt is string && data.publishedAt.size() <= 40;
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && (existing().active == true || isAdmin());
      allow list: if existing().active == true || isAdmin();
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(productId) && isAdmin() && isValidProduct(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'slug', 'name', 'shortDescription', 'description', 'price', 'promoPrice',
          'stock', 'category', 'resourceType', 'recommendedAge', 'tags', 'images',
          'videoUrl', 'variants', 'featured', 'active', 'salesCount', 'weightGrams',
          'updatedAt'
        ]);
      allow delete: if isValidId(productId) && isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(orderId) && isValidOrder(incoming())
        && incoming().id == orderId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (incoming().source == 'loja' && incoming().status == 'pendente') ||
          isAdmin()
        );
      allow update: if isValidId(orderId) && isAdmin() && isValidOrder(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']);
      allow delete: if isValidId(orderId) && isAdmin();
    }

    match /coupons/{couponId} {
      allow get: if isValidId(couponId);
      allow list: if isAdmin();
      allow create: if isValidId(couponId) && isAdmin() && isValidCoupon(incoming())
        && incoming().code == couponId
        && incoming().createdAt == request.time;
      allow update: if isValidId(couponId) && isAdmin() && isValidCoupon(incoming())
        && incoming().code == existing().code
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'type', 'value', 'minOrderValue', 'maxUses', 'usedCount', 'expiresAt', 'active'
        ]);
      allow delete: if isValidId(couponId) && isAdmin();
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'store' || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(settingId) && isAdmin() && isValidSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(settingId) && isAdmin() && isValidSettings(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'storeName', 'tagline', 'primaryColor', 'accentColor', 'whatsappNumber',
          'instagramUrl', 'facebookUrl', 'tiktokUrl', 'contactEmail', 'cityState',
          'originCep', 'freeShippingThreshold', 'welcomeMessage', 'footerText',
          'shippingPolicy', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /blogPosts/{postId} {
      allow get: if isValidId(postId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();
      allow create: if isValidId(postId) && isAdmin() && isValidBlogPost(incoming())
        && incoming().id == postId;
      allow update: if isValidId(postId) && isAdmin() && isValidBlogPost(incoming())
        && incoming().id == existing().id
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'slug', 'title', 'excerpt', 'content', 'category',
          'readTime', 'coverImage', 'published', 'publishedAt'
        ]);
      allow delete: if isValidId(postId) && isAdmin();
    }

    function isValidStudent(data) {
      return data.keys().hasAll([
        'uid', 'fullName', 'email', 'phone', 'cpf', 'studentOrChildName',
        'gradeOrAge', 'cityState', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'fullName', 'email', 'phone', 'cpf', 'studentOrChildName',
        'gradeOrAge', 'cityState', 'notes', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid)
      && data.fullName is string && data.fullName.size() >= 3 && data.fullName.size() <= 140
      && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
      && data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 30
      && data.cpf is string && data.cpf.size() >= 11 && data.cpf.size() <= 20
      && data.studentOrChildName is string && data.studentOrChildName.size() >= 2 && data.studentOrChildName.size() <= 140
      && data.gradeOrAge is string && data.gradeOrAge.size() >= 2 && data.gradeOrAge.size() <= 80
      && data.cityState is string && data.cityState.size() >= 2 && data.cityState.size() <= 120
      && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 600));
    }

    function isValidDigitalMaterial(data) {
      return data.keys().hasAll([
        'id', 'slug', 'title', 'description', 'levelOrSubject', 'recommendedAge',
        'pagesCount', 'price', 'coverImage', 'fileName', 'active', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'slug', 'title', 'description', 'levelOrSubject', 'recommendedAge',
        'pagesCount', 'price', 'promoPrice', 'coverImage', 'fileName', 'active', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 140 && data.slug.matches('^[a-z0-9\\-]+$')
      && data.title is string && data.title.size() >= 3 && data.title.size() <= 160
      && data.description is string && data.description.size() >= 5 && data.description.size() <= 4000
      && data.levelOrSubject is string && data.levelOrSubject.size() >= 2 && data.levelOrSubject.size() <= 80
      && data.recommendedAge is string && data.recommendedAge.size() >= 2 && data.recommendedAge.size() <= 60
      && data.pagesCount is number && data.pagesCount >= 1 && data.pagesCount <= 2000
      && data.price is number && data.price >= 0 && data.price <= 100000
      && (!('promoPrice' in data) || data.promoPrice == null || (data.promoPrice is number && data.promoPrice >= 0 && data.promoPrice <= 100000))
      && data.coverImage is string && data.coverImage.size() >= 1 && data.coverImage.size() <= 500
      && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160
      && data.active is bool;
    }

    function isValidMaterialAsset(data) {
      return data.keys().hasAll(['materialId', 'pdfUrl', 'fileName', 'updatedAt'])
      && data.keys().hasOnly(['materialId', 'pdfUrl', 'fileName', 'updatedAt'])
      && isValidId(data.materialId)
      && data.pdfUrl is string && data.pdfUrl.size() >= 1 && data.pdfUrl.size() <= 1000
      && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160;
    }

    function isValidStudentGrant(data) {
      return data.keys().hasAll([
        'id', 'studentId', 'studentName', 'studentEmail', 'materialId',
        'materialTitle', 'coverImage', 'pdfUrl', 'fileName', 'grantedAt'
      ])
      && data.keys().hasOnly([
        'id', 'studentId', 'studentName', 'studentEmail', 'materialId',
        'materialTitle', 'materialDescription', 'levelOrSubject', 'pagesCount',
        'coverImage', 'pdfUrl', 'fileName', 'orderRef', 'notes', 'grantedAt'
      ])
      && isValidId(data.id)
      && isValidId(data.studentId)
      && data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 140
      && data.studentEmail is string && data.studentEmail.size() >= 3 && data.studentEmail.size() <= 160
      && isValidId(data.materialId)
      && data.materialTitle is string && data.materialTitle.size() >= 2 && data.materialTitle.size() <= 160
      && (!('materialDescription' in data) || data.materialDescription == null || (data.materialDescription is string && data.materialDescription.size() <= 4000))
      && (!('levelOrSubject' in data) || data.levelOrSubject == null || (data.levelOrSubject is string && data.levelOrSubject.size() <= 80))
      && (!('pagesCount' in data) || data.pagesCount == null || (data.pagesCount is number && data.pagesCount >= 1 && data.pagesCount <= 2000))
      && data.coverImage is string && data.coverImage.size() >= 1 && data.coverImage.size() <= 500
      && data.pdfUrl is string && data.pdfUrl.size() >= 1 && data.pdfUrl.size() <= 1000
      && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160
      && (!('orderRef' in data) || data.orderRef == null || (data.orderRef is string && data.orderRef.size() <= 40))
      && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 600));
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow write: if false;
    }

    match /students/{studentId} {
      allow get: if isValidId(studentId) && ((isSignedIn() && request.auth.uid == studentId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(studentId) && isSignedIn() && isValidStudent(incoming())
        && (request.auth.uid == studentId || isAdmin())
        && incoming().uid == studentId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(studentId) && isSignedIn() && isValidStudent(incoming())
        && (request.auth.uid == studentId || isAdmin())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'email', 'phone', 'cpf', 'studentOrChildName',
          'gradeOrAge', 'cityState', 'notes', 'updatedAt'
        ]);
      allow delete: if isValidId(studentId) && isAdmin();
    }

    match /digitalMaterials/{materialId} {
      allow get: if isValidId(materialId) && (existing().active == true || isAdmin());
      allow list: if existing().active == true || isAdmin();
      allow create: if isValidId(materialId) && isAdmin() && isValidDigitalMaterial(incoming())
        && incoming().id == materialId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(materialId) && isAdmin() && isValidDigitalMaterial(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'slug', 'title', 'description', 'levelOrSubject', 'recommendedAge',
          'pagesCount', 'price', 'promoPrice', 'coverImage', 'fileName', 'active', 'updatedAt'
        ]);
      allow delete: if isValidId(materialId) && isAdmin();
    }

    match /materialAssets/{materialId} {
      allow get: if isValidId(materialId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(materialId) && isAdmin() && isValidMaterialAsset(incoming())
        && incoming().materialId == materialId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(materialId) && isAdmin() && isValidMaterialAsset(incoming())
        && incoming().materialId == existing().materialId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['pdfUrl', 'fileName', 'updatedAt']);
      allow delete: if isValidId(materialId) && isAdmin();
    }

    match /studentGrants/{grantId} {
      allow get: if isValidId(grantId) && isSignedIn() && (isAdmin() || existing().studentId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || existing().studentId == request.auth.uid);
      allow create: if isValidId(grantId) && isAdmin() && isValidStudentGrant(incoming())
        && incoming().id == grantId
        && incoming().grantedAt == request.time
        && exists(/databases/$(database)/documents/students/$(incoming().studentId))
        && exists(/databases/$(database)/documents/digitalMaterials/$(incoming().materialId));
      allow update: if isValidId(grantId) && isAdmin() && isValidStudentGrant(incoming())
        && incoming().id == existing().id
        && incoming().studentId == existing().studentId
        && incoming().materialId == existing().materialId
        && incoming().grantedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['orderRef', 'notes', 'pdfUrl', 'fileName', 'grantedAt']);
      allow delete: if isValidId(grantId) && isAdmin();
    }
  }
}
